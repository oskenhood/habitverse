# ============================================================
# HabitVerse — переменные окружения
# Скопируйте этот файл в .env.local и заполните значения.
#   cp .env.example .env.local
#
# ⚠️  Supabase до конца 2026 выводит из обращения legacy-ключи
#     `anon` (eyJ...) и `service_role` (eyJ...).
#     Новые ключи: `sb_publishable_...` и `sb_secret_...`.
#     Работают обе схемы — берите новую, если есть выбор.
# ============================================================

# ---------- Supabase: URL проекта ----------
# Dashboard → кнопка "Connect" (справа сверху) → вкладка App
# Либо: Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# ---------- Supabase: публичный (publishable) ключ ----------
# Dashboard → "Connect" → App → NEXT_PUBLIC_SUPABASE_ANON_KEY
# Либо: Settings → API Keys → Publishable and secret API keys
# Безопасен для браузера: доступ ограничен политиками RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Supabase: секретный (secret) ключ ----------
# Settings → API Keys → secret key  (sb_secret_...)
# 🔒 НИКОГДА не добавляйте префикс NEXT_PUBLIC_ и не коммитьте в git!
# Нужен только для Vercel Cron → Edge Function. Если используете pg_cron
# внутри Supabase (рекомендуется), эта переменная не обязательна:
# Edge Function получает SUPABASE_SECRET_KEY автоматически.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# legacy-вариант того же самого (если у вас старый проект):
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- Web Push (VAPID) ----------
# Генерация:  npx web-push generate-vapid-keys
# Public Key  → сюда и в Vercel (NEXT_PUBLIC_*, попадает в клиентский бандл)
# Private Key → ТОЛЬКО в секреты Supabase Edge Function:
#   supabase secrets set VAPID_PRIVATE_KEY="..."
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Защита cron-роута Vercel ----------
# Любая длинная случайная строка. Vercel сам подставляет её в заголовок
# Authorization: Bearer <CRON_SECRET> при вызове /api/cron/*
# Генерация:  openssl rand -hex 32
CRON_SECRET=

# ---------- Прочее ----------
# Адрес сайта (нужен для редиректов Supabase Auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
